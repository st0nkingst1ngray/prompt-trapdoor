# Copy to .env.local (gitignored via *.local) if you want the Worker URL pre-filled in the hub settings.
# URL only. The HARNESS_TOKEN is NEVER put here: anything prefixed VITE_ is baked into the public JS/APK.
# Paste the token in-game (hub → Grok 4.7 harness → ⚙️ API); it stays in that device's localStorage.
VITE_HARNESS_API_URL=https://hunter-harness-api.<your-subdomain>.workers.dev
